            },
            "description": "only points after this unix time"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "only points at or before this unix time",
              "title": "Until"
            },
            "description": "only points at or before this unix time"
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "seconds; at most one point per step-second bucket (the earliest in it)",
              "title": "Step"
            },
            "description": "seconds; at most one point per step-second bucket (the earliest in it)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "description": "at most this many, newest kept",
              "default": 7200,
              "title": "Limit"
            },
            "description": "at most this many, newest kept"
          },
          {
            "name": "token",
            "in": "query",
